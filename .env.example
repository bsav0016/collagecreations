# Local development settings for the Vite dev server. Copy to .env.local (gitignored):
#   macOS/Linux:  cp .env.example .env.local
#   Windows:      copy .env.example .env.local
# These are build-time values and end up in the browser bundle, so only put public values here
# (publishable Stripe key, OAuth client IDs) - never a secret key.

# The Django API, with a trailing slash. Defaults to http://localhost:8000/ in `npm run dev`.
VITE_BACKEND_URL=http://localhost:8000/

# Stripe *publishable* test key (pk_test_...). Required for the checkout card form.
VITE_STRIPE_KEY=pk_test_replace_me

# Optional. The public Google / Microsoft sign-in client IDs default to the production apps.
# VITE_GOOGLE_CLIENT_ID=
# VITE_MICROSOFT_CLIENT_ID=

# Optional error reporting.
# VITE_SENTRY_DSN=
